[Unit]
Description=Sablier KEY4 refresh button watcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=HOME=/home/happylittle7
WorkingDirectory=/home/happylittle7/Developer/Sablier
ExecStart=/usr/bin/python3 /home/happylittle7/Developer/Sablier/button_daemon.py
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
