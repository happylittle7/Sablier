[Unit]
Description=Sablier e-paper dashboard daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=HOME=/home/happylittle7
WorkingDirectory=/home/happylittle7/Developer/Sablier
ExecStart=/usr/bin/python3 /home/happylittle7/Developer/Sablier/main.py --daemon
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
