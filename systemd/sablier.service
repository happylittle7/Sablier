[Unit]
Description=Sablier e-paper dashboard daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=HOME=%h
EnvironmentFile=-%h/.config/sablier/weather.env
WorkingDirectory=%h/Developer/Sablier
ExecStart=/usr/bin/python3 %h/Developer/Sablier/main.py --daemon
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
